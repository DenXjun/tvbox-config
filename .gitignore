.git.remote/
.git.push/
_*.py
_*.json
*.test.json
*.test2.json
*.ranked.json
*.ranked.legacy.json
drpy-sandbox/node_modules/
__pycache__/
*.pyc

# 工装构建中间物（build_jar.sh 产出，设备上跑的那份同样由脚本重编，别入库）
csp-device/*.jar
csp-device/bc_*/
csp-device/bo_*/
# 会话级工装与真机拉回产物（一次性脚本、done_/jobs_ 结果、迁移备份）
# 不入库：daily 一次 git add -A 就会把几百 MB 设备输出卷进历史
.qoder-tmp/
.workbuddy/

# deps 回收站（dedup_prune.py / cleanup_deps.py 的移动目标，30 天后真删）
# 绝不入库：这里躺的是刚被判定为"无引用 + 有内容替身"的副本，体积是
# deps 真实内容的零头，入库等于把刚清掉的体积原样塞回 git 历史
deps/.trash/
